<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NavegacionMaui_IAGM.Views.InformacionPage"
             Title="InformacionPage">
    <VerticalStackLayout Padding="24" Spacing="26">
        <Label Text="Llegaste a la segunda página"
               FontSize="26"
               FontAttributes="Bold" />

        <Label Text="Esta pantalla se abrió mediante Shell."
               FontSize="18" />

        <!-- Este botón regresa a la pantalla anterior. -->
        <Button Text="Regresar"
                Clicked="OnRegresarClicked" />
    </VerticalStackLayout>
</ContentPage>